{
  "name": "gif-maker",
  "version": "1.0.0",
  "description": "Elegant video to GIF converter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "gif",
    "video",
    "converter",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "canvas": "^3.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "png2icons": "^2.0.1"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.2"
  },
  "build": {
    "appId": "com.gifmaker.app",
    "productName": "GIF Maker",
    "icon": "build/icon.png",
    "win": {
      "target": ["dir"],
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!create-icon.html",
      "!generate-icon.js"
    ]
  }
}
